# Proveedor de IA: groq o claude
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

PORT=3000

# Base de datos MySQL: mysql://USUARIO:CONTRASEÑA@localhost:3306/lab5_notas
# (si la contraseña tiene simbolos como @ o #, escribelos codificados: @ = %40, # = %23)
DATABASE_URL=mysql://root:TU_CONTRASEÑA@localhost:3306/lab5_notas
