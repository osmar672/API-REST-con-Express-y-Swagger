{
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-libsql": "6.19.0",
    "@prisma/client": "6.19.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.62.1",
    "prisma": "6.19.0",
    "supertest": "^7.3.2"
  },
  "name": "lab5-notas-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node lab5-api/src/index.js",
    "dev": "nodemon lab5-api/src/index.js",
