// Esquema de la base de datos SQLite (reto extra: persistencia con Prisma).
// Después de cambiar este archivo: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Nota {
  id        Int    @id @default(autoincrement())
  titulo    String
  contenido String

  @@map("notas")
}
